      <div class="country-links">
        <div class="section-label">🌐 General Information</div>
        <a href="https://en.wikipedia.org/wiki/Japan" target="_blank">Wikipedia</a>
        <a href="https://www.auswaertiges-amt.de/de/service/laender/japan-node" target="_blank">German Foreign Office</a>
        <a href="https://www.lonelyplanet.com/japan" target="_blank">Lonely Planet</a>
      </div>
      <div class="source-links">
        <div class="section-label">📊 Further Sources</div>
        <a href="https://www.who.int/countries/jpn" target="_blank">WHO Japan <span class="source-tag">Health</span></a>
        <a href="https://www.oecd.org/japan/" target="_blank">OECD Japan <span class="source-tag">Economy</span></a>
        <a href="https://www.numbeo.com/cost-of-living/country_result.jsp?country=Japan" target="_blank">Numbeo Japan <span class="source-tag">Cost of Living</span></a>
        <a href="https://ourworldindata.org/country/japan" target="_blank">Our World in Data <span class="source-tag">Statistics</span></a>
      </div>
    `
  }
];
 
countries.forEach(country => {
  const marker = L.marker(country.coords).addTo(map);
  marker.on('click', () => {
    openPanel(country.infoHtml, country.name, country.bgColor);
  });
  marker.bindTooltip(country.name, { permanent: false, direction: 'top' });
});
 
map.on('click', function (e) {
  const { lat, lng } = e.latlng;
  L.popup()
    .setLatLng(e.latlng)
    .setContent(`<b>Coordinates:</b><br>Lat: ${lat.toFixed(2)}, Lng: ${lng.toFixed(2)}`)
    .openOn(map);
});
 
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    if (infoPanel.classList.contains('open')) closePanel();
    document.getElementById('sources-overlay').classList.remove('open');
  }
});
 
window.addEventListener('resize', () => {
  if (!infoPanel.classList.contains('open')) {
    document.getElementById('map').style.width = '100%';
  } else {
    document.getElementById('map').style.width = window.innerWidth > 900 ? '60%' : '100%';
  }
  setTimeout(() => map.invalidateSize(), 250);
});
</script>

  <script src="https://cdn.botpress.cloud/webchat/v3.6/inject.js"></script>
  <script src="https://files.bpcontent.cloud/2026/05/19/15/20260519150325-JR5O6FFS.js" defer></script>
    

</body>
</html>
 
