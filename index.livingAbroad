  </div>

</div>

  </div>
</div>
 
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script>
const map = L.map('map', {
  minZoom: 2, maxZoom: 6, worldCopyJump: false,
  maxBounds: [[-85, -180], [85, 180]], maxBoundsViscosity: 1
}).setView([20, 0], 2);
 
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
  attribution: '&copy; OpenStreetMap contributors', maxZoom: 19, noWrap: true
}).addTo(map);
 
const infoPanel = document.getElementById('info-panel');
 
function openPanel(htmlContent, countryName, bgColor) {
  infoPanel.style.background = bgColor || '#ffffff';
  infoPanel.innerHTML = `
    <div class="close-btn" id="panel-close">Close ✕</div>
    <h2 class="panel-title">${countryName}</h2>
    <div class="panel-subtitle">Detailed living abroad profile</div>
    ${htmlContent}
  `;
  infoPanel.classList.add('open');
  infoPanel.setAttribute('aria-hidden', 'false');
  if (window.innerWidth > 900) document.getElementById('map').style.width = '60%';
  else document.getElementById('map').style.width = '100%';
  setTimeout(() => map.invalidateSize(), 300);
  document.getElementById('panel-close').addEventListener('click', closePanel);
}
 
function closePanel() {
  infoPanel.classList.remove('open');
  infoPanel.setAttribute('aria-hidden', 'true');
  infoPanel.innerHTML = '';
  document.getElementById('map').style.width = '100%';
  setTimeout(() => map.invalidateSize(), 300);
}
 
// Close sources overlay on backdrop click
document.getElementById('sources-overlay').addEventListener('click', function(e) {
  if (e.target === this) this.classList.remove('open');
});
 
const countries = [
  {
    name: "USA",
    coords: [38.0, -97.0],
    bgColor: "#dce8f5",
    infoHtml: `
      <div class="highlight">
        <div class="detail-row"><b>🔒 Safety:</b> <span class="rating-stars">⭐⭐⭐</span></div>
        <div class="detail-row"><b>💶 Monthly cost:</b> 1,500–2,500 € (typical, varies by city)</div>
        <div class="detail-row"><b>☀️ Climate:</b> Extremely varied — from tropical Florida to arctic Alaska</div>
      </div>
      <div class="detail-row"><b>🎭 Culture:</b> A diverse and open society with a strong performance and career focus. Regional differences are large — urban centers are fast-paced, while many areas are more relaxed.</div>
      <div class="detail-row"><b>🗣️ Language:</b> American English with many regional accents; widely understood everywhere.</div>
      <div class="detail-row"><b>🎓 Education:</b> Home to world-class universities and many top-ranked schools; excellent higher education opportunities.</div>
      <div class="detail-row"><b>🏥 Healthcare:</b> Predominantly private and expensive — health insurance is essential for residents and long-term visitors.</div>
      <div class="detail-row"><b>✈️ Flight time:</b> ~9–11 hours from Central Europe</div>
      <div class="detail-row"><b>🔗 Programs:</b></div>
      <ul class="program-list">
        <li><a href="https://www.yfu.de/schueleraustausch/gastlaender/usa" target="_blank">YFU USA</a></li>
        <li><a href="https://www.afs.de/programs/schueleraustausch-usa/" target="_blank">AFS USA</a></li>
        <li><a href="https://www.ef.de/aya/destinations/united-states/" target="_blank">EF High School Exchange USA</a></li>
      </ul>
      <div class="small-note">💡 Tip: Research city-specific costs (e.g., New York vs. Midwest) and secure health insurance before departure.</div>
      <div class="country-links">
        <div class="section-label">🌐 General Information</div>
        <a href="https://en.wikipedia.org/wiki/United_States" target="_blank">Wikipedia</a>
        <a href="https://www.auswaertiges-amt.de/de/service/laender/usa-node" target="_blank">German Foreign Office</a>
        <a href="https://www.lonelyplanet.com/usa" target="_blank">Lonely Planet</a>
      </div>
      <div class="source-links">
        <div class="section-label">📊 Further Sources</div>
        <a href="https://www.who.int/countries/usa" target="_blank">WHO USA <span class="source-tag">Health</span></a>
        <a href="https://www.oecd.org/unitedstates/" target="_blank">OECD USA <span class="source-tag">Economy</span></a>
        <a href="https://www.numbeo.com/cost-of-living/country_result.jsp?country=United+States" target="_blank">Numbeo USA <span class="source-tag">Cost of Living</span></a>
        <a href="https://www.ghsindex.org/country/united-states/" target="_blank">GHS Index USA <span class="source-tag">Safety</span></a>
      </div>
    `
  },
  {
    name: "Canada",
    coords: [56.0, -106.0],
    bgColor: "#fde8e8",
    infoHtml: `
      <div class="highlight">
        <div class="detail-row"><b>🔒 Safety:</b> <span class="rating-stars">⭐⭐⭐⭐⭐</span></div>
        <div class="detail-row"><b>💶 Monthly cost:</b> 1,200–2,000 €</div>
        <div class="detail-row"><b>☀️ Climate:</b> Cold winters, pleasant summers — large regional differences</div>
      </div>
      <div class="detail-row"><b>🎭 Culture:</b> Very multicultural and tolerant; cities are welcoming to internationals.</div>
      <div class="detail-row"><b>🗣️ Language:</b> Clear, easy-to-understand English; French in Quebec.</div>
      <div class="detail-row"><b>🎓 Education:</b> Excellent public school system and strong universities.</div>
      <div class="detail-row"><b>🏥 Healthcare:</b> Publicly funded and generally accessible (varies by province).</div>
      <div class="detail-row"><b>✈️ Flight time:</b> ~8–10 hours from Central Europe</div>
      <div class="detail-row"><b>🔗 Programs:</b></div>
      <ul class="program-list">
        <li><a href="https://www.yfu.de/schueleraustausch/gastlaender/kanada" target="_blank">YFU Canada</a></li>
        <li><a href="https://www.sts-education.com/de/high-school/kanada/" target="_blank">STS Canada</a></li>
        <li><a href="https://www.experiment-ev.de/schueleraustausch/kanada/" target="_blank">Experiment Canada</a></li>
      </ul>
      <div class="small-note">💡 Tip: Consider provincial differences in services and cost of living; major cities are pricier.</div>
      <div class="country-links">
        <div class="section-label">🌐 General Information</div>
        <a href="https://en.wikipedia.org/wiki/Canada" target="_blank">Wikipedia</a>
        <a href="https://www.auswaertiges-amt.de/de/service/laender/kanada-node" target="_blank">German Foreign Office</a>
        <a href="https://www.lonelyplanet.com/canada" target="_blank">Lonely Planet</a>
      </div>
      <div class="source-links">
        <div class="section-label">📊 Further Sources</div>
        <a href="https://www.who.int/countries/can" target="_blank">WHO Canada <span class="source-tag">Health</span></a>
        <a href="https://www.oecd.org/canada/" target="_blank">OECD Canada <span class="source-tag">Economy</span></a>
        <a href="https://www.numbeo.com/cost-of-living/country_result.jsp?country=Canada" target="_blank">Numbeo Canada <span class="source-tag">Cost of Living</span></a>
        <a href="https://www.visionofhumanity.org/maps/#/" target="_blank">Global Peace Index <span class="source-tag">Safety</span></a>
      </div>
    `
  },
  {
    name: "United Kingdom",
    coords: [54.0, -2.0],
    bgColor: "#f0eaf7",
    infoHtml: `
      <div class="highlight">
        <div class="detail-row"><b>🔒 Safety:</b> <span class="rating-stars">⭐⭐⭐⭐</span></div>
        <div class="detail-row"><b>💶 Monthly cost:</b> 1,500–2,200 €</div>
        <div class="detail-row"><b>☀️ Climate:</b> Cool, often cloudy and rainy</div>
      </div>
      <div class="detail-row"><b>🎭 Culture:</b> A mix of tradition and modernity; politeness and etiquette are valued.</div>
      <div class="detail-row"><b>🗣️ Language:</b> British English (RP and regional accents) — excellent for formal English learning.</div>
      <div class="detail-row"><b>🎓 Education:</b> World-class institutions (Oxford, Cambridge) and strong secondary education (A-Levels).</div>
