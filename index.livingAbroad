<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8" />
<title>Living Abroad – Interaktive Karte</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<style>
html, body { margin: 0; padding: 0; height: 100%; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
#map { height: 100vh; width: 100vw; transition: width 0.25s ease; float: left; }
#info-panel {
  position: fixed; right: 0; top: 0; height: 100vh; width: 0; max-width: 45%;
  box-shadow: -6px 0 18px rgba(0,0,0,0.12); overflow-y: auto;
  transition: width 0.25s ease, padding 0.25s ease; padding: 0; z-index: 1000;
}
#info-panel.open { width: 40%; padding: 20px 24px; }
#info-panel .close-btn {
  display: inline-block; background: rgba(0,0,0,0.10); border-radius: 6px;
  padding: 6px 10px; cursor: pointer; margin-bottom: 12px; font-weight: 600;
}
.panel-title { margin: 0 0 8px 0; font-size: 20px; font-weight: 700; }
.panel-subtitle { margin: 0 0 16px 0; color: #444; font-size: 14px; }
.detail-row { margin: 10px 0; line-height: 1.45; }
.detail-row b { display: inline-block; width: 120px; color: #222; }
.highlight {
  border-left: 4px solid rgba(0,0,0,0.15);
  padding: 10px; margin: 12px 0; border-radius: 6px;
  background: rgba(255,255,255,0.35);
}
.program-list { margin: 8px 0 0 0; padding-left: 18px; }
.program-list li { margin: 5px 0; }
.program-list a { color: #1a73e8; text-decoration: none; font-weight: 500; }
.program-list a:hover { text-decoration: underline; }
.small-note { margin-top: 12px; font-size: 13px; color: #555; }
.rating-stars { color: #f5b301; font-weight: 700; }

/* Programme-Links Sektion */
.country-links {
  margin-top: 18px;
  padding-top: 14px;
  border-top: 1px solid rgba(0,0,0,0.12);
}
.country-links .section-label {
  margin: 0 0 8px 0;
  font-weight: 700;
  font-size: 13px;
  color: #222;
}
.country-links a {
  display: inline-block;
  margin: 4px 6px 4px 0;
  padding: 5px 11px;
  background: rgba(255,255,255,0.55);
  border: 1px solid rgba(0,0,0,0.15);
  border-radius: 20px;
  font-size: 13px;
  color: #1a73e8;
  text-decoration: none;
  transition: background 0.15s;
}
.country-links a:hover { background: rgba(255,255,255,0.85); text-decoration: underline; }

/* Quellen-Sektion */
.source-links {
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid rgba(0,0,0,0.12);
}
.source-links .section-label {
  margin: 0 0 8px 0;
  font-weight: 700;
  font-size: 13px;
  color: #222;
}
.source-links a {
  display: flex;
  align-items: center;
  gap: 7px;
  margin: 5px 0;
  font-size: 13px;
  color: #1a73e8;
  text-decoration: none;
}
.source-links a:hover { text-decoration: underline; }
.source-tag {
  display: inline-block;
  font-size: 11px;
  padding: 2px 7px;
  border-radius: 10px;
  background: rgba(0,0,0,0.08);
  color: #444;
  white-space: nowrap;
}

@media (max-width: 900px) {
  #info-panel.open { width: 100%; }
  #map { width: 100%; }
}
</style>
</head>
<body>
<div id="map"></div>
<aside id="info-panel" aria-hidden="true"></aside>
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script>
const map = L.map('map', {
  minZoom: 2, maxZoom: 6, worldCopyJump: false,
  maxBounds: [[-85, -180], [85, 180]], maxBoundsViscosity: 1
}).setView([20, 0], 2);

L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
  attribution: '&copy; OpenStreetMap-Mitwirkende', maxZoom: 19, noWrap: true
}).addTo(map);

const infoPanel = document.getElementById('info-panel');

function openPanel(htmlContent, countryName, bgColor) {
  infoPanel.style.background = bgColor || '#ffffff';
  infoPanel.innerHTML = `
    <div class="close-btn" id="panel-close">Close ✕</div>
    <h2 class="panel-title">${countryName}</h2>
    <div class="panel-subtitle">Detailed living abroad profile</div>
    ${htmlContent}
  `;
  infoPanel.classList.add('open');
  infoPanel.setAttribute('aria-hidden', 'false');
  if (window.innerWidth > 900) document.getElementById('map').style.width = '60%';
  else document.getElementById('map').style.width = '100%';
  setTimeout(() => map.invalidateSize(), 300);
  document.getElementById('panel-close').addEventListener('click', closePanel);
}

function closePanel() {
  infoPanel.classList.remove('open');
  infoPanel.setAttribute('aria-hidden', 'true');
  infoPanel.innerHTML = '';
  document.getElementById('map').style.width = '100%';
  setTimeout(() => map.invalidateSize(), 300);
}

const countries = [
  {
    name: "USA",
    coords: [38.0, -97.0],
    bgColor: "#dce8f5",
    infoHtml: `
      <div class="highlight">
        <div class="detail-row"><b>🔒 Safety:</b> <span class="rating-stars">⭐⭐⭐</span></div>
        <div class="detail-row"><b>💶 Monthly cost:</b> 1.500–2.500 € (typical, varies by city)</div>
        <div class="detail-row"><b>☀️ Climate:</b> Extremely varied — from tropical Florida to arctic Alaska</div>
      </div>
      <div class="detail-row"><b>🎭 Culture:</b> A diverse and open society with a strong performance and career focus. Regional differences are large — urban centers are fast-paced, while many areas are more relaxed.</div>
      <div class="detail-row"><b>🗣️ Language:</b> American English with many regional accents; widely understood everywhere.</div>
      <div class="detail-row"><b>🎓 Education:</b> Home to world-class universities and many top-ranked schools; excellent higher education opportunities.</div>
      <div class="detail-row"><b>🏥 Healthcare:</b> Predominantly private and expensive — health insurance is essential for residents and long-term visitors.</div>
      <div class="detail-row"><b>✈️ Flight time:</b> ~9–11 hours from Central Europe</div>
      <div class="detail-row"><b>🔗 Programs:</b></div>
