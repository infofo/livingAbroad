<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>Living Abroad – Interactive Map</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<style>
html, body { margin: 0; padding: 0; height: 100%; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
#map { height: 100vh; width: 100vw; transition: width 0.25s ease; float: left; }
#info-panel {
  position: fixed; right: 0; top: 0; height: 100vh; width: 0; max-width: 45%;
  box-shadow: -6px 0 18px rgba(0,0,0,0.12); overflow-y: auto;
  transition: width 0.25s ease, padding 0.25s ease; padding: 0; z-index: 1000;
}
#info-panel.open { width: 40%; padding: 20px 24px; }
#info-panel .close-btn {
  display: inline-block; background: rgba(0,0,0,0.10); border-radius: 6px;
  padding: 6px 10px; cursor: pointer; margin-bottom: 12px; font-weight: 600;
}
.panel-title { margin: 0 0 8px 0; font-size: 20px; font-weight: 700; }
.panel-subtitle { margin: 0 0 16px 0; color: #444; font-size: 14px; }
.detail-row { margin: 10px 0; line-height: 1.45; }
.detail-row b { display: inline-block; width: 120px; color: #222; }
.highlight {
  border-left: 4px solid rgba(0,0,0,0.15);
  padding: 10px; margin: 12px 0; border-radius: 6px;
  background: rgba(255,255,255,0.35);
}
.program-list { margin: 8px 0 0 0; padding-left: 18px; }
.program-list li { margin: 5px 0; }
.program-list a { color: #1a73e8; text-decoration: none; font-weight: 500; }
.program-list a:hover { text-decoration: underline; }
.small-note { margin-top: 12px; font-size: 13px; color: #555; }
.rating-stars { color: #f5b301; font-weight: 700; }
 
.country-links {
  margin-top: 18px;
  padding-top: 14px;
  border-top: 1px solid rgba(0,0,0,0.12);
}
.country-links .section-label {
  margin: 0 0 8px 0;
  font-weight: 700;
  font-size: 13px;
  color: #222;
}
.country-links a {
  display: inline-block;
  margin: 4px 6px 4px 0;
  padding: 5px 11px;
  background: rgba(255,255,255,0.55);
  border: 1px solid rgba(0,0,0,0.15);
  border-radius: 20px;
  font-size: 13px;
  color: #1a73e8;
  text-decoration: none;
  transition: background 0.15s;
}
.country-links a:hover { background: rgba(255,255,255,0.85); text-decoration: underline; }
 
.source-links {
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid rgba(0,0,0,0.12);
}
.source-links .section-label {
  margin: 0 0 8px 0;
  font-weight: 700;
  font-size: 13px;
  color: #222;
}
.source-links a {
  display: flex;
  align-items: center;
  gap: 7px;
  margin: 5px 0;
  font-size: 13px;
  color: #1a73e8;
  text-decoration: none;
}
.source-links a:hover { text-decoration: underline; }
.source-tag {
  display: inline-block;
  font-size: 11px;
  padding: 2px 7px;
  border-radius: 10px;
  background: rgba(0,0,0,0.08);
  color: #444;
  white-space: nowrap;
}
 
/* ── Sources Button (bottom-left) ── */
#sources-btn {
  position: fixed;
  bottom: 20px;
  left: 20px;
  z-index: 2000;
  background: rgba(255,255,255,0.92);
  border: 1px solid rgba(0,0,0,0.18);
  border-radius: 10px;
  padding: 8px 14px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 4px 14px rgba(0,0,0,0.15);
  transition: background 0.15s, box-shadow 0.15s;
  color: #222;
}
#sources-btn:hover { background: #fff; box-shadow: 0 6px 20px rgba(0,0,0,0.2); }
 
/* ── Sources Overlay ── */
#sources-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.55);
  backdrop-filter: blur(6px);
  z-index: 3000;
  place-items: center;
}
#sources-overlay.open { display: grid; }
#sources-box {
  width: min(520px, 92%);
  max-height: 80vh;
  overflow-y: auto;
  padding: 28px 28px 24px;
  border-radius: 18px;
  background: rgba(255,255,255,0.97);
  box-shadow: 0 20px 50px rgba(0,0,0,0.25);
  position: relative;
}
#sources-box h2 {
  margin: 0 0 4px 0;
  font-size: 18px;
  font-weight: 700;
}
#sources-box .sources-subtitle {
  margin: 0 0 18px 0;
  font-size: 13px;
  color: #666;
}
#sources-box .source-item {
  padding: 10px 0;
  border-bottom: 1px solid rgba(0,0,0,0.08);
  font-size: 14px;
  color: #333;
  line-height: 1.5;
}
#sources-box .source-item:last-child { border-bottom: none; }
#sources-box .close-sources {
  position: absolute;
  top: 16px;
  right: 18px;
  background: rgba(0,0,0,0.08);
  border: none;
  border-radius: 8px;
  padding: 5px 10px;
  cursor: pointer;
  font-size: 14px;
  font-weight: 600;
  color: #333;
}
#sources-box .close-sources:hover { background: rgba(0,0,0,0.14); }
#sources-placeholder {
  color: #888;
  font-style: italic;
  font-size: 14px;
  text-align: center;
  padding: 20px 0;
}
 
/* ── Startup Popup ── */
#popup {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  background: rgba(0,0,0,0.6);
  backdrop-filter: blur(8px);
  z-index: 9999;
}
.popup-box {
  width: min(340px, 90%);
  padding: 24px;
  text-align: center;
  border-radius: 24px;
  background: rgba(255,255,255,0.93);
  box-shadow: 0 20px 50px rgba(0,0,0,0.25);
}
.popup-box img {
  width: 90px;
  height: 90px;
  object-fit: cover;
  border-radius: 50%;
  margin-bottom: 14px;
  border: 3px solid rgba(0,0,0,0.08);
}
.popup-box p {
  margin: 0 0 20px 0;
  font-size: 14px;
  line-height: 1.6;
  color: #333;
}
.popup-box button {
  background: #1a73e8;
  color: #fff;
  border: none;
  border-radius: 12px;
  padding: 10px 28px;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s;
}
.popup-box button:hover { background: #1558b0; }
 
@media (max-width: 900px) {
  #info-panel.open { width: 100%; }
  #map { width: 100%; }
}
</style>
</head>
<body>
 
<!-- ── Startup Popup ── -->
<div id="popup">
  <div class="popup-box">
    <img src="https://conrad-von-soest-gymnasium.de/wp-content/uploads/elementor/thumbs/Conny_iPad-pqqfr113re50rt1h7tg4dgi53z9o4rdp8djjhqyfts.png" alt="Conny">
    <p>
      Hi, lets visit some interesting countrys for living abroad!
    </p>
    <button onclick="document.getElementById('popup').remove()">Let's go!</button>
  </div>
</div>
 
<!-- ── Map ── -->
<div id="map"></div>
 
<!-- ── Side Info Panel ── -->
<aside id="info-panel" aria-hidden="true"></aside>
 
<!-- ── Sources Button ── -->
<button id="sources-btn" onclick="document.getElementById('sources-overlay').classList.add('open')">
  📚 Sources
</button>
 
<!-- ── Sources Overlay ── -->
<div id="sources-overlay" role="dialog" aria-modal="true" aria-label="Sources">
  <div id="sources-box">
    <button class="close-sources" onclick="document.getElementById('sources-overlay').classList.remove('open')" aria-label="Close">✕ Close</button>
    <h2>📚 Sources &amp; References</h2>
    <p class="sources-subtitle">All sources used for this project.</p>
 
    <!-- ═══════════════════════════════════════════════════
         ADD YOUR SOURCES HERE — duplicate .source-item divs
         ═══════════════════════════════════════════════════ -->
<div id="sources">

  <p><strong>Note:</strong> Values such as safety levels, cost estimates, and general country characteristics are approximations based on publicly available data. They may vary depending on region, year, and methodology.</p>

  <div class="source-item">
